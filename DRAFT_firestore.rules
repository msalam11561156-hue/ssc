rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isOptionalString(mapData, key, maxLen) {
      return !(key in mapData) || (mapData[key] is string && mapData[key].size() <= maxLen);
    }

    function isOptionalSmallMap(mapData, key, maxKeys) {
      return !(key in mapData) || (mapData[key] is map && mapData[key].keys().size() <= maxKeys);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role is string && data.role == 'educator'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolDataMap(school) {
      return school is map
        && school.keys().size() <= 20
        && school.keys().hasOnly([
          'affiliatedEntity',
          'affiliatedEntityEn',
          'administration',
          'administrationEn',
          'schoolName',
          'schoolNameEn',
          'educationType',
          'educationTypeEn',
          'stage',
          'stageEn',
          'semester',
          'division',
          'systemType',
          'secondarySystem'
        ])
        && isOptionalString(school, 'affiliatedEntity', 32)
        && isOptionalString(school, 'affiliatedEntityEn', 100)
        && isOptionalString(school, 'administration', 150)
        && isOptionalString(school, 'administrationEn', 150)
        && isOptionalString(school, 'schoolName', 150)
        && isOptionalString(school, 'schoolNameEn', 150)
        && isOptionalString(school, 'educationType', 64)
        && isOptionalString(school, 'educationTypeEn', 100)
        && isOptionalString(school, 'stage', 64)
        && isOptionalString(school, 'stageEn', 100)
        && isOptionalString(school, 'semester', 32)
        && isOptionalString(school, 'division', 64)
        && isOptionalString(school, 'systemType', 32)
        && isOptionalString(school, 'secondarySystem', 32);
    }

    function isValidWorkspaceConfig(data) {
      return data.keys().hasAll(['ownerId', 'schoolData', 'controlDataByStage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'schoolData', 'controlDataByStage', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidSchoolDataMap(data.schoolData)
        && data.controlDataByStage is map && data.controlDataByStage.keys().size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentGroup(data) {
      return data.keys().hasAll(['ownerId', 'groupId', 'stageKey', 'studentCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'groupId', 'stageKey', 'studentCount', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.groupId)
        && data.stageKey is string && data.stageKey.size() >= 1 && data.stageKey.size() <= 200
        && data.studentCount is int && data.studentCount >= 0 && data.studentCount <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentRecord(data) {
      return data.keys().hasAll([
          'ownerId',
          'groupId',
          'stageKey',
          'orderIndex',
          'studentId',
          'name',
          'nationalId',
          'gender',
          'enrollmentStatus',
          'religion',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'groupId',
          'stageKey',
          'orderIndex',
          'studentId',
          'name',
          'nameEn',
          'nationalId',
          'gender',
          'enrollmentStatus',
          'exemptionStatus',
          'enrollmentType',
          'studentStatus',
          'religion',
          'seatNumber',
          'secretNumber',
          'committeeNumber',
          'seatNumbers',
          'secretNumbers',
          'committeeNumbers',
          'assessments',
          'writtenExams',
          'detailedAssessments',
          'studentClass',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.groupId)
        && data.stageKey is string && data.stageKey.size() >= 1 && data.stageKey.size() <= 200
        && data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 5000
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && isOptionalString(data, 'nameEn', 200)
        && data.nationalId is string && data.nationalId.size() <= 32
        && data.gender is string && data.gender.size() <= 32
        && data.enrollmentStatus is string && data.enrollmentStatus.size() <= 64
        && isOptionalString(data, 'exemptionStatus', 64)
        && isOptionalString(data, 'enrollmentType', 64)
        && isOptionalString(data, 'studentStatus', 64)
        && data.religion is string && data.religion.size() <= 32
        && isOptionalString(data, 'seatNumber', 32)
        && isOptionalString(data, 'secretNumber', 32)
        && isOptionalString(data, 'committeeNumber', 32)
        && isOptionalString(data, 'studentClass', 64)
        && isOptionalSmallMap(data, 'seatNumbers', 10)
        && isOptionalSmallMap(data, 'secretNumbers', 10)
        && isOptionalSmallMap(data, 'committeeNumbers', 10)
        && isOptionalSmallMap(data, 'assessments', 10)
        && isOptionalSmallMap(data, 'writtenExams', 10)
        && isOptionalSmallMap(data, 'detailedAssessments', 10)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /private/{infoId} {
        allow get: if isValidId(userId) && isValidId(infoId) && isOwner(userId) && infoId == 'info';
        allow list: if false;
        allow create: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(infoId)
          && infoId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow delete: if false;
      }

      match /workspaces/{workspaceId} {
        allow get: if isValidId(userId) && isValidId(workspaceId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidWorkspaceConfig(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && isValidWorkspaceConfig(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['schoolData', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['controlDataByStage', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['schoolData', 'controlDataByStage', 'updatedAt'])
          );
        allow delete: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(workspaceId)
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }

      match /studentGroups/{groupId} {
        allow get: if isValidId(userId) && isValidId(groupId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(groupId)
          && isValidStudentGroup(incoming())
          && incoming().groupId == groupId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(groupId)
          && isValidStudentGroup(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().groupId == existing().groupId
          && incoming().stageKey == existing().stageKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'updatedAt']);
        allow delete: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(groupId)
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }

      match /students/{studentDocId} {
        allow get: if isValidId(userId) && isValidId(studentDocId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(studentDocId)
          && isValidStudentRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/studentGroups/$(incoming().groupId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(studentDocId)
          && isValidStudentRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().groupId == existing().groupId
          && incoming().stageKey == existing().stageKey
          && incoming().studentId == existing().studentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)/studentGroups/$(existing().groupId)).data.ownerId == request.auth.uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderIndex',
              'name',
              'nameEn',
              'nationalId',
              'gender',
              'enrollmentStatus',
              'exemptionStatus',
              'enrollmentType',
              'studentStatus',
              'religion',
              'seatNumber',
              'secretNumber',
              'committeeNumber',
              'seatNumbers',
              'secretNumbers',
              'committeeNumbers',
              'studentClass',
              'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'assessments',
              'writtenExams',
              'detailedAssessments',
              'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderIndex',
              'name',
              'nameEn',
              'nationalId',
              'gender',
              'enrollmentStatus',
              'exemptionStatus',
              'enrollmentType',
              'studentStatus',
              'religion',
              'seatNumber',
              'secretNumber',
              'committeeNumber',
              'seatNumbers',
              'secretNumbers',
              'committeeNumbers',
              'assessments',
              'writtenExams',
              'detailedAssessments',
              'studentClass',
              'updatedAt'
            ])
          );
        allow delete: if isSignedIn()
          && isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(studentDocId)
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
